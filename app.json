{
  "expo": {
    "name": "Manjula Milk Forming",
    "slug": "manjula-milk-forming",
    "owner": "govindarajv848",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F4D1C"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F4D1C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.manjulamilkforming.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Manjula Milk to capture your location so the seller can deliver milk to you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F4D1C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec8e95cc-4c09-4992-8a82-a07d9132bfb7"
      }
    }
  }
}
